# CyberSec Lab Trainer - Environment Configuration
# Copy this file to .env and fill in the values

# --- Required Secrets (MUST be changed in production) ---
# Generate NEXTAUTH_SECRET: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# --- Database Configuration ---
# Choose one: sqlite (default), postgresql, mysql, mongodb
DATABASE_TYPE=sqlite

# For SQLite (default):
DATABASE_URL=file:./dev.db

# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/cybersec_trainer
# POSTGRES_PASSWORD=your-secure-password

# For MySQL:
# MYSQL_ROOT_PASSWORD=your-root-password

# For MongoDB:
# MONGODB_URI=mongodb://localhost:27017/cybersec_lab

# --- Application URL ---
NEXTAUTH_URL=http://localhost:3000

# --- OAuth Providers (optional - leave empty for demo mode) ---
# Google: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
# GITHUB_ID=
# GITHUB_SECRET=
