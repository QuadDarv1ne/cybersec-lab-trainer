# Database Configuration
# Set DATABASE_TYPE to: postgresql, mysql, or sqlite
DATABASE_TYPE=postgresql

# PostgreSQL (default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cybersec_lab?schema=public

# MySQL alternative
# DATABASE_URL=mysql://root:password@localhost:3306/cybersec_lab

# SQLite (local development, no server needed)
# DATABASE_URL=file:./dev.db

# NextAuth.js
# Generate a secure random key for production:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# JWT (for crypto exercises)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Port Configuration
# The development server auto-detects an available port starting from 3000.
# To override, set PORT=<number> before running dev.
