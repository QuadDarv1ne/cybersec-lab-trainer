# CyberSec Lab Trainer — Environment Variables
# Скопируйте этот файл в .env.local и заполните значения

# === NextAuth ===
# Secret for NextAuth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=
# Base URL for NextAuth (e.g. http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# === GitHub OAuth ===
# https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app
GITHUB_ID=
GITHUB_SECRET=

# === Google OAuth ===
# https://developers.google.com/identity/protocols/oauth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Database ===
# PostgreSQL connection string
# For local dev: postgresql://cybersec:cybersec@localhost:5432/cybersec_trainer
# For production: use strong credentials from your secrets manager
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# === Application ===
# JWT secret for crypto exercises
JWT_SECRET=

# Node environment (development | production)
NODE_ENV=development
