# CyberSec Lab Trainer — Environment Variables
# Скопируйте этот файл в .env.local и заполните значения:
#   cp .env.example .env.local

# === NextAuth ===
# Secret for NextAuth (generate with: openssl rand -base64 32)
# Example: NEXTAUTH_SECRET=U2FsdGVkX1+abc123...
NEXTAUTH_SECRET=

# Base URL for NextAuth
NEXTAUTH_URL=http://localhost:3000

# === GitHub OAuth ===
# https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# === Google OAuth ===
# https://developers.google.com/identity/protocols/oauth2
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Database ===
# PostgreSQL connection string
# Local dev:    DATABASE_URL="postgresql://user:password@localhost:5432/cybersec_trainer?schema=public"
# Docker:       DATABASE_URL="postgresql://cybersec:cybersec@db:5432/cybersec_trainer?schema=public"
# Production:   Use a managed database with strong credentials
DATABASE_URL="postgresql://user:password@localhost:5432/cybersec_trainer?schema=public"

# === Application ===
# JWT secret for crypto exercises (generate with: openssl rand -hex 32)
JWT_SECRET=

# Node environment (development | production)
NODE_ENV=development

# === Upstash Redis (Rate Limiting) ===
# Optional — in-memory fallback is used if not configured
# https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
