// CyberSec Lab Trainer — PostgreSQL Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  progress      Progress[]
  quizResults   QuizResult[]
  challengeProgress ChallengeProgress[]
  itemProgress  ItemProgress[]
  notes         Note[]
  studySessions StudySession[]
  labProgress   LabProgress[]
  flagSubmissions FlagSubmission[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  moduleId    String
  completed   Boolean  @default(false)
  score       Int?
  lastAccessed DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("progress")
}

model QuizResult {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int
  total     Int
  percentage Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@map("quiz_results")
}

model ChallengeProgress {
  id            String   @id @default(cuid())
  userId        String
  challengeType String
  correct       Int      @default(0)
  total         Int      @default(0)
  answered      Json?
  selectedOptions Json?
  updatedAt     DateTime @updatedAt @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeType])
  @@map("challenge_progress")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ItemProgress {
  id        String   @id @default(cuid())
  userId    String
  moduleId  String
  itemIds   Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("item_progress")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  moduleId  String
  moduleName String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, moduleId])
  @@index([userId, itemId])
  @@map("notes")
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  date      String
  durationMs Int
  pageType  String
  xpEarned  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, pageType])
  @@map("study_sessions")
}

// CTF Lab models

model Lab {
  id          String     @id @default(cuid())
  number      Int        @unique
  title       String
  description String
  goal        String
  tools       String
  difficulty  String     @default("medium")
  category    String
  order       Int        @default(0)
  createdAt   DateTime   @default(now())

  flags       LabFlag[]
  progress    LabProgress[]
  submissions FlagSubmission[]

  @@map("labs")
}

model LabFlag {
  id        String   @id @default(cuid())
  labId     String
  flagKey   String
  flagValue String
  points    Int      @default(10)
  hint      String?

  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@map("lab_flags")
}

model LabProgress {
  id          String   @id @default(cuid())
  userId      String
  labId       String
  status      String   @default("not_started")
  flagsFound  Int      @default(0)
  totalFlags  Int      @default(0)
  score       Int      @default(0)
  startedAt   DateTime?
  completedAt DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([userId, labId])
  @@map("lab_progress")
}

model FlagSubmission {
  id        String   @id @default(cuid())
  userId    String
  labId     String
  flagKey   String
  flagValue String
  correct   Boolean
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([userId, labId, flagKey])
  @@index([userId, correct])
  @@map("flag_submissions")
}
